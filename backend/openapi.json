{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/register": {
      "post": {
        "summary": "Register",
        "description": "Create an account and sign in to it.",
        "operationId": "register_api_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "409": {
            "description": "Username taken"
          },
          "422": {
            "description": "Invalid username or password"
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login",
        "operationId": "login_api_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Wrong username or password"
          },
          "429": {
            "description": "Too many failed attempts for this username"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Logout",
        "operationId": "logout_api_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Me",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Account",
        "description": "Delete the account and all its boards, and sign out.",
        "operationId": "delete_account_api_me_delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordConfirmation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Password is wrong"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/password": {
      "put": {
        "summary": "Change Password",
        "description": "Change the password. Other sessions are signed out; this one stays signed in.",
        "operationId": "change_password_api_me_password_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Current password is wrong"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "List Users",
        "description": "Every user, sorted by username.",
        "operationId": "list_users_api_admin_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserInfo"
                  },
                  "type": "array",
                  "title": "Response List Users Api Admin Users Get"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin"
          }
        }
      }
    },
    "/api/admin/users/{username}": {
      "patch": {
        "summary": "Set Role",
        "description": "Make the user an admin, or not. The last admin cannot be removed.",
        "operationId": "set_role_api_admin_users__username__patch",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No such user"
          },
          "409": {
            "description": "The last admin"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete User",
        "description": "Delete the user and their boards. Admins delete their own account from account settings.",
        "operationId": "delete_user_api_admin_users__username__delete",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No such user"
          },
          "409": {
            "description": "Yourself (use DELETE /api/me)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users/{username}/password": {
      "put": {
        "summary": "Reset Password",
        "description": "Set a new password for the user: signs them out everywhere and lifts a sign-in lockout.",
        "operationId": "reset_password_api_admin_users__username__password_put",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordReset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Not an admin"
          },
          "404": {
            "description": "No such user"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/boards": {
      "get": {
        "summary": "List Boards",
        "description": "The boards the user owns or that are shared with them, oldest first.",
        "operationId": "list_boards_api_boards_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BoardSummary"
                  },
                  "type": "array",
                  "title": "Response List Boards Api Boards Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Board",
        "description": "Create a board with the standard columns and no cards.",
        "operationId": "create_board_api_boards_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BoardName"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/boards/{board_id}": {
      "get": {
        "summary": "Get Board",
        "operationId": "get_board_api_boards__board_id__get",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Rename Board",
        "operationId": "rename_board_api_boards__board_id__patch",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BoardName"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardSummary"
                }
              }
            }
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "403": {
            "description": "Only the board's owner can do this"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Board",
        "operationId": "delete_board_api_boards__board_id__delete",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "403": {
            "description": "Only the board's owner can do this"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save Board",
        "description": "Save the board if it is still at `update.version` (optimistic concurrency).",
        "operationId": "save_board_api_boards__board_id__put",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VersionedBoard"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionedBoard"
                }
              }
            }
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "409": {
            "description": "Board changed since `version`; body has the current board"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/boards/{board_id}/members": {
      "get": {
        "summary": "List Members",
        "description": "Usernames the board is shared with (not including the owner).",
        "operationId": "list_members_api_boards__board_id__members_get",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "title": "Response List Members Api Boards  Board Id  Members Get"
                }
              }
            }
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add Member",
        "description": "Share the board with another user; returns the members.",
        "operationId": "add_member_api_boards__board_id__members_post",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewMember"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "title": "Response Add Member Api Boards  Board Id  Members Post"
                }
              }
            }
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "403": {
            "description": "Only the board's owner can do this"
          },
          "409": {
            "description": "Already a member, or the owner"
          },
          "422": {
            "description": "No such user"
          }
        }
      }
    },
    "/api/boards/{board_id}/members/{username}": {
      "delete": {
        "summary": "Remove Member",
        "description": "The owner removes a member, or a member leaves the board.",
        "operationId": "remove_member_api_boards__board_id__members__username__delete",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          },
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "403": {
            "description": "Only the board's owner can do this"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/boards/{board_id}/activity": {
      "get": {
        "summary": "List Activity",
        "description": "The board's latest changes, newest first (owner and members).",
        "operationId": "list_activity_api_boards__board_id__activity_get",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityEntry"
                  },
                  "title": "Response List Activity Api Boards  Board Id  Activity Get"
                }
              }
            }
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/boards/{board_id}/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_api_boards__board_id__chat_post",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Board Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such board (or not shared with you)"
          },
          "502": {
            "description": "The AI call failed; `detail` is a message for the user"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin"
          }
        },
        "type": "object",
        "required": [
          "username",
          "is_admin"
        ],
        "title": "Account"
      },
      "ActivityEntry": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "via_ai": {
            "type": "boolean",
            "title": "Via Ai"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "username",
          "message",
          "via_ai",
          "created_at"
        ],
        "title": "ActivityEntry"
      },
      "Board": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/Column"
            },
            "type": "array",
            "title": "Columns"
          },
          "cards": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Card"
            },
            "type": "object",
            "title": "Cards"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "columns",
          "cards"
        ],
        "title": "Board"
      },
      "BoardDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "members": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Members"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "board": {
            "$ref": "#/components/schemas/Board"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "owner",
          "members",
          "version",
          "board"
        ],
        "title": "BoardDetail"
      },
      "BoardName": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "BoardName"
      },
      "BoardSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "cards": {
            "type": "integer",
            "title": "Cards"
          },
          "done": {
            "type": "integer",
            "title": "Done"
          },
          "overdue": {
            "type": "integer",
            "title": "Overdue"
          },
          "mine": {
            "type": "integer",
            "title": "Mine"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "updated_at",
          "owner",
          "cards",
          "done",
          "overdue",
